DATABASE_URL=postgresql://credit:credit_local@localhost:5432/credit?schema=public
RABBITMQ_URL=amqp://credit:credit_local@localhost:5672
REDIS_URL=redis://localhost:6379
API_KEY=local-development-key-change-me
PORT=3000
MAX_ATTEMPTS=3
RETRY_BASE_MS=1000
DISPATCH_INTERVAL_MS=1000
REPUBLISH_AFTER_MS=10000
WORKER_PREFETCH=8
RATE_LIMIT_PER_MINUTE=120
# Probability = min(0.5, amount / 100000 * 0.5). Disabled by default for predictable demos.
SIMULATION_ENABLED=false
SIMULATION_SCALE_AMOUNT=100000
