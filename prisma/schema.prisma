generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaymentStatus {
  PENDING
  QUEUED
  PROCESSING
  SUCCEEDED
  FAILED
}

enum TransactionType {
  CREDIT
  DEBIT
}

model User {
  id           String           @id @default(uuid()) @db.Uuid
  name         String           @db.VarChar(100)
  balance      BigInt           @default(0)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  payments     PaymentRequest[]
  transactions Transaction[]

  @@map("users")
}

model PaymentRequest {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  user            User          @relation(fields: [userId], references: [id])
  amount          BigInt
  reference       String        @db.VarChar(100)
  description     String        @db.VarChar(500)
  idempotencyKey  String        @unique @map("idempotency_key") @db.VarChar(100)
  status          PaymentStatus @default(PENDING)
  attempts        Int           @default(0)
  failureCode     String?        @map("failure_code")
  failureReason   String?        @map("failure_reason")
  retryable       Boolean       @default(false)
  nextAttemptAt   DateTime?      @map("next_attempt_at") @db.Timestamptz(3)
  lastPublishedAt DateTime?      @map("last_published_at") @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  transaction     Transaction?
  events          PaymentEvent[]

  @@index([status, nextAttemptAt, lastPublishedAt])
  @@index([userId, createdAt])
  @@map("payment_requests")
}

model Transaction {
  id              String          @id @default(uuid()) @db.Uuid
  userId          String          @map("user_id") @db.Uuid
  user            User            @relation(fields: [userId], references: [id])
  paymentId       String?         @unique @map("payment_id") @db.Uuid
  payment         PaymentRequest? @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  idempotencyKey  String?         @unique @map("idempotency_key") @db.VarChar(100)
  type            TransactionType
  amount          BigInt
  reference       String          @db.VarChar(100)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId, createdAt])
  @@index([createdAt, type])
  @@map("transactions")
}

model PaymentEvent {
  id        BigInt         @id @default(autoincrement())
  paymentId String         @map("payment_id") @db.Uuid
  payment   PaymentRequest @relation(fields: [paymentId], references: [id])
  type      String
  details   Json?
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([paymentId, id])
  @@map("payment_events")
}
