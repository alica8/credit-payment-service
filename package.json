{
  "name": "credit-payment-service",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "format": "prettier --write src test scripts public package.json tsconfig.json compose.yaml .prettierrc.json",
    "format:check": "prettier --check src test scripts public package.json tsconfig.json compose.yaml .prettierrc.json",
    "start": "node dist/src/main.js",
    "start:dev": "tsx watch src/main.ts",
    "worker": "node dist/src/worker.js",
    "worker:dev": "tsx watch src/worker.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "test": "npm run build && node --test dist/test/unit.test.js",
    "test:integration": "npm run build && node scripts/integration.mjs",
    "test:e2e": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "@prisma/client": "6.19.3",
    "amqplib": "^0.10.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.2.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.7",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "prettier": "3.6.2",
    "prisma": "6.19.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "multer": "2.4.0",
    "deepmerge-ts": "8.0.2",
    "effect": "3.22.2"
  }
}
